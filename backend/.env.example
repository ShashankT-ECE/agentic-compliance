# Backend environment configuration
# Copy to .env and fill in values

# PostgreSQL connection (asyncpg driver)
# Local dev: use localhost. Docker: use 'db' as hostname
DATABASE_URL=postgresql+asyncpg://compliance:compliance@localhost:5432/compliance_db

# DeepSeek API (required for LLM features — Nodes 1 & 2)
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_TIMEOUT=300

# Application
SECRET_KEY=change-me-to-a-random-secret
LOG_LEVEL=INFO

# Database (optional overrides)
# DB_ECHO=false
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
